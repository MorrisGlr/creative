  "media": [
    {
        "type": "image",
        "src": "DSC05316.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. February 2026.",
        "caption": "A statue's patience is unmatched for the lifelong learning photographer."
    },
    {
        "type": "image",
        "src": "DSC03890.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. January 2026.",
        "caption": "I used the time the statue gave me to get more familiar with the shadows a human figure casts."
    },
    {
        "type": "image",
        "src": "DSC03901.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. January 2026.",
        "caption": "While the sculptor forms the object, a photographer can control how the point of view emphasizes its features via photo composition."
    },
    {
        "type": "image",
        "src": "DSC03913.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. January 2026.",
        "caption": "In short spans of time, statues are unchanging, but the environment they are set in is not, providing more ways to draw attention to the statue."
    },
    {
        "type": "image",
        "src": "DSC04667.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. February 2026.",
        "caption": "For outdoor statues, the changing seasons can add to the photo composition."
    },
    {
        "type": "image",
        "src": "DSC04996.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. February 2026.",
        "caption": "While indoors, foot traffic around the art piece can add interest and context."
    },
    {
        "type": "image",
        "src": "DSC04998.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. February 2026.",
        "caption": "Another reason statues make good subjects is that they don't blink or get confused about what to do with their hands."
    },
    {
        "type": "image",
        "src": "DSC05002.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. February 2026.",
        "caption": "However, they don't let me practice directing a subject."
    },
    {
        "type": "image",
        "src": "DSC05007.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. February 2026.",
        "caption": "At best, statues can simulate a stubborn person and teach me that I cannot always win."
    },
    {
        "type": "image",
        "src": "DSC05227.jpg",
        "alt": "",
        "attribution": "Morris A. Aguilar. February 2026.",
        "caption": "The best lesson these figures gave me is to look harder when I think something is unchanging."
    },
